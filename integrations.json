{
  "uses": [
    {
      "plugin": "bitwarden.secrets",
      "paths": [
        ".github/workflows/deploy.yml",
        "src/convergence/walker.py",
        "with-secrets.json"
      ],
      "mode": "required"
    },
    {
      "plugin": "github.app-token",
      "paths": [
        ".github/workflows/deploy.yml",
        "src/convergence/tokens.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "github.ghcr",
      "paths": [
        ".github/workflows/deploy.yml",
        "Dockerfile",
        "k8s/engine.yaml",
        "k8s/kustomization.yaml"
      ],
      "mode": "required"
    },
    {
      "plugin": "github.repo-ops",
      "paths": [
        ".github/workflows/deploy.yml",
        "src/convergence/walker.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "google.cloud",
      "paths": [
        ".github/workflows/deploy.yml",
        "src/convergence/engine.py",
        "src/convergence/google.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "letsencrypt.certs",
      "paths": [
        "k8s/ingress.yaml"
      ],
      "mode": "required"
    },
    {
      "plugin": "sonarcloud.scan",
      "paths": [
        ".github/workflows/main.yml",
        ".github/workflows/pr.yml"
      ],
      "mode": "required"
    },
    {
      "plugin": "storage.api",
      "paths": [
        "src/convergence/main.py"
      ],
      "mode": "required"
    },
    {
      "plugin": "tailscale.tailnet",
      "paths": [
        "pubkit.json"
      ],
      "mode": "required"
    }
  ],
  "exclude": [
    {
      "path": "tests/steps/test_engine.py",
      "reason": "Checks the walk's environment, with made-up tokens, against a faked pubdeploy"
    },
    {
      "path": "tests/steps/test_fulfil.py",
      "reason": "Checks a Fulfil's and a round's walk environments, with made-up tokens, against a faked pubdeploy"
    }
  ],
  "own_hosts": [
    "sustenaut.eu"
  ],
  "other_hosts": [
    {
      "host": "dl.k8s.io",
      "reason": "kubectl's release, pinned by sha256, in the image"
    },
    {
      "host": "dl.google.com",
      "reason": "gcloud's release archive, pinned by sha256, in the image"
    },
    {
      "host": "sts.googleapis.com",
      "reason": "gcloud trades the pod's projected token for a Google credential there (Workload Identity Federation)"
    },
    {
      "host": "iamcredentials.googleapis.com",
      "reason": "gcloud impersonates the key reader or key admin account there"
    }
  ],
  "other_secrets": [
    {
      "name": "SUSTENAUT_DEPLOY_SSH_KEY",
      "reason": "An SSH key to our own server"
    }
  ]
}
